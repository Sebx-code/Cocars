        ViewMessageHistory["Voir l'historique des messages"]
    end
    
    subgraph AdminFunctions["⚙️ FONCTIONS ADMINISTRATEUR"]
        ManageUsers["Gérer les utilisateurs"]
        ViewAllUsers["Afficher tous les utilisateurs"]
