        ViewBookingStats["Voir les stats de réservation"]
        ViewPaymentStats["Voir les stats de paiement"]
        GenerateReports["Générer des rapports"]
        HandleDisputes["Gérer les litiges"]
        ReviewDispute["Examiner un litige"]
        ResolveDispute["Résoudre un litige"]
        ViewAuditLog["Consulter les logs d'audit"]
        ManagePlatform["Gérer la plateforme"]
    end
    
    %% ===== Relationships=====
    
    %% Guest relationships
    Guest --> SearchTrip
    Guest --> ViewTrip
    Guest --> ViewRatings
    Guest --> ViewUserProfile
    Guest --> Login
    Guest --> Register
    
    %% Driver relationships
    Driver --> Auth
    Driver --> TripManagement
    Driver --> BookingManagement
    Driver --> PaymentManagement
    Driver --> VehicleManagement
    Driver --> RatingReview
    Driver --> Notification
    Driver --> Verification
    Driver --> Communication
    
    Driver --> CreateTrip
    Driver --> ListMyTrips
    Driver --> ConfirmBooking
    Driver --> RejectBooking
    Driver --> ConfirmDeparture
    Driver --> AddVehicle
    Driver --> RatePassenger
    Driver --> ProcessPayment
    Driver --> ManageWallet
    Driver --> WithdrawFunds
    Driver --> ViewBalance
    
    %% Passenger relationships
    Passenger --> Auth
    Passenger --> TripManagement
    Passenger --> BookingManagement
    Passenger --> PaymentManagement
    Passenger --> RatingReview
    Passenger --> Notification
    Passenger --> Verification
    Passenger --> Communication
    
    Passenger --> SearchTrip
    Passenger --> BookTrip
    Passenger --> ViewBooking
    Passenger --> CancelBooking
    Passenger --> ConfirmDeparture
    Passenger --> RateDriver
    Passenger --> ProcessPayment
    Passenger --> RequestRefund
    Passenger --> ManageWallet
    Passenger --> AddFunds
    
    %% Admin relationships
    Admin --> AdminFunctions
    Admin --> Auth
    Admin --> ViewAnalytics
    Admin --> Verification
    
    %% Include relationships
    BookTrip -.->|include| ProcessPayment
    ProcessPayment -.->|include| ChoosePaymentMethod
