graph LR
    subgraph Actors["👥 ACTEURS DU SYSTÈME"]
        Admin["👑 Administrateur"]
        Driver["🚗 Chauffeur"]
        Passenger["👨 Passager"]
        Guest["👁️ Visiteur"]
    end
    
    subgraph Auth["🔐 AUTHENTIFICATION & PROFIL"]
        Register["Créer un compte"]
        Login["Se connecter"]
        Logout["Se déconnecter"]
        ResetPassword["Réinitialiser le mot de passe"]
        UpdateProfile["Mettre à jour le profil"]
        UploadAvatar["Charger une photo de profil"]
        DeleteAvatar["Supprimer la photo de profil"]
        ChangePassword["Changer le mot de passe"]
    end
    
    subgraph TripManagement["📍 GESTION DES TRAJETS"]
        CreateTrip["Créer un trajet"]
        SearchTrip["Rechercher des trajets"]
        SearchAdvanced["Recherche avancée/filtrée"]
        ViewTrip["Consulter les détails du trajet"]
        UpdateTrip["Modifier un trajet"]
        CancelTrip["Annuler un trajet"]
        ListMyTrips["Consulter mes trajets"]
        FilterByPreferences["Filtrer par préférences"]
        ViewTripMap["Voir sur la carte"]
    end
    
    subgraph BookingManagement["📋 GESTION DES RÉSERVATIONS"]
        BookTrip["Réserver une place"]
        ViewBooking["Consulter les réservations"]
