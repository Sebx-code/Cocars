    UploadDocuments -.->|include| UploadLicense
    UploadDocuments -.->|include| UploadSelfie
    VerifyIdentity -.->|extend| UploadDocuments
    VerifyPhone -.->|include| SendSMS
    VerifyPhone -.->|include| ConfirmPhone
    RequestRefund -.->|extend| ProcessRefund
    ManageWallet -.->|include| AddFunds
    ManageWallet -.->|include| WithdrawFunds
    ManageWallet -.->|include| ViewBalance
    ViewNotifications -.->|include| MarkAsRead
    DeleteMessage -.->|extend| ViewMessages
    HandleDisputes -.->|include| ReviewDispute
    HandleDisputes -.->|include| ResolveDispute
    ManageUsers -.->|include| SuspendUser
    ManageUsers -.->|include| BanUser
    ViewAnalytics -.->|include| ViewBookingStats
    ViewAnalytics -.->|include| ViewPaymentStats
    
