        CancelBooking["Annuler une réservation"]
        ConfirmDeparture["Confirmer le départ"]
        MarkNoShow["Signaler une absence"]
        DriverNoShow["Absence du chauffeur"]
        ValidateDeparture["Valider le départ"]
        RequestCancellation["Demander l'annulation"]
    end
    
    subgraph PaymentManagement["💳 GESTION DES PAIEMENTS"]
        ProcessPayment["Effectuer un paiement"]
        ChoosePaymentMethod["Choisir le mode de paiement"]
        CardPayment["Paiement par carte"]
        WalletPayment["Paiement portefeuille"]
        CashPayment["Paiement en espèces"]
        ViewPaymentHistory["Consulter l'historique"]
        RequestRefund["Demander un remboursement"]
        ProcessRefund["Traiter le remboursement"]
        ManageWallet["Gérer le portefeuille"]
        AddFunds["Ajouter des fonds"]
        WithdrawFunds["Retirer des fonds"]
        ViewBalance["Consulter le solde"]
        ViewTransactionDetails["Voir détails transaction"]
    end
    
    subgraph VehicleManagement["🚙 GESTION DES VÉHICULES"]
        AddVehicle["Ajouter un véhicule"]
        ListVehicles["Consulter mes véhicules"]
        EditVehicle["Modifier un véhicule"]
        DeleteVehicle["Supprimer un véhicule"]
        UploadPhoto["Charger photos du véhicule"]
        SetPrimaryPhoto["Définir photo principale"]
        DeletePhoto["Supprimer une photo"]
        SetDefaultVehicle["Définir le véhicule par défaut"]
        ViewVehicleDetails["Voir détails du véhicule"]
        SpecifyFeatures["Spécifier les caractéristiques"]
    end
    
    subgraph RatingReview["⭐ NOTATION & AVIS"]
        RateTrip["Noter un trajet"]
        RateDriver["Noter le chauffeur"]
        RatePassenger["Noter le passager"]
        ViewRatings["Consulter les évaluations"]
        ViewDriverRatings["Voir les notes du chauffeur"]
        ViewCredibility["Consulter le score de crédibilité"]
        ViewUserProfile["Consulter le profil utilisateur"]
        ViewUserStats["Voir les statistiques utilisateur"]
        UpdateCredibility["Mettre à jour la crédibilité"]
        ReportBadBehavior["Signaler un mauvais comportement"]
    end
    
    subgraph Notification["🔔 NOTIFICATIONS"]
        ViewNotifications["Consulter les notifications"]
        MarkAsRead["Marquer comme lu"]
        MarkAllAsRead["Marquer tout comme lu"]
        DeleteNotification["Supprimer une notification"]
        ClearNotifications["Effacer toutes les notifications"]
        ReceiveBookingNotif["Recevoir notification réservation"]
        ReceivePaymentNotif["Recevoir notification paiement"]
        ReceiveMessageNotif["Recevoir notification message"]
    end
    
    subgraph Verification["✅ VÉRIFICATION & SÉCURITÉ"]
        VerifyPhone["Vérifier le numéro de téléphone"]
        SendSMS["Envoyer code SMS"]
        ConfirmPhone["Confirmer le code SMS"]
        UploadDocuments["Charger documents d'identité"]
        UploadIDCard["Charger carte d'identité"]
        UploadLicense["Charger permis de conduire"]
        UploadSelfie["Charger selfie"]
        VerifyIdentity["Vérifier l'identité"]
        CheckVerificationStatus["Consulter l'état de vérification"]
        ResubmitDocuments["Resoumetre les documents"]
    end
    
    subgraph Communication["💬 COMMUNICATION"]
        SendMessage["Envoyer un message"]
        ViewMessages["Consulter les messages"]
        StartConversation["Démarrer une conversation"]
