---
title: Diagramme d'Activité - Réservation et Paiement de Trajet
config:
  theme: base
  themeVariables:
    fontSize: 10px
    fontFamily: 'Arial, sans-serif'
    primaryColor: '#2196F3'
    primaryTextColor: '#000000'
    primaryBorderColor: '#1565C0'
    lineColor: '#333333'
    sectionBkgColor: '#ffffff'
    altSectionBkgColor: '#f8f9fa'
    gridColor: '#e9ecef'
    tertiaryColor: '#f8f9fa'
  flowchart:
    nodeSpacing: 20
    rankSpacing: 35
    curve: 'basis'
    padding: 6
    htmlLabels: true
    useMaxWidth: true
---

graph TD
    %% Main Activity: Complete Trip Booking & Payment Flow

    %% Passenger initiates booking
    A["Passager recherche<br/>un trajet"] --> B{"Trajet<br/>trouvé ?"}
    B -->|Non| A
    B -->|Oui| C["Consulter les détails<br/>du trajet"]

    C --> D["Confirmer<br/>la réservation"]
    D --> E{"Places<br/>disponibles ?"}
    E -->|Non| F["Trajet complet"]
    F --> G["Retourner à<br/>la recherche"]
    G --> A
    E -->|Oui| H["Créer<br/>la réservation"]

    H --> I["En attente<br/>Statut: PENDING"]
    I --> J{"Chauffeur<br/>confirme ?"}
    J -->|Rejette| K["Réservation<br/>rejetée"]
    K --> L["Consulter le message<br/>du chauffeur"]
    L --> G

    J -->|Confirme| M["Réservation confirmée<br/>Statut: CONFIRMED"]
    M --> N["Procéder<br/>au paiement"]

    N --> O["Sélectionner le mode<br/>de paiement"]
    O --> P{"Mode de<br/>paiement ?"}
    P -->|Carte bancaire| Q["Paiement en ligne"]
    P -->|Portefeuille| R["Débiter le<br/>portefeuille"]
    P -->|Espèces| S["Paiement en espèces<br/>(à confirmer)"]

    Q --> T["Traiter la<br/>transaction"]
    R --> T
    S --> T

    T --> U{"Paiement<br/>réussi ?"}
    U -->|Échoué| V["Paiement échoué"]
    V --> W{"Réessayer ?"}
    W -->|Oui| N
    W -->|Non| X["Réservation en attente<br/>de paiement"]
    X --> A

    U -->|Réussi| Y["Paiement confirmé"]
    Y --> Z["Envoyer confirmation<br/>au passager"]
    Z --> AA["Status:<br/>IN_PROGRESS"]

    AA --> AB["Attendre la date/heure<br/>du départ"]
    AB --> AC["Passager confirme<br/>la présence"]

    AC --> AD{"Passager<br/>confirmé ?"}
    AD -->|Non| AE["Absence passager<br/>(No-Show)"]
    AD -->|Oui| AF["Présence confirmée<br/>Prêt pour le départ"]

    AE --> AG["Débiter les frais<br/>de No-Show"]
    AG --> AH["Notification<br/>d'absence"]

    AF --> AI["Chauffeur confirme<br/>la présence"]
    AI --> AJ{"Chauffeur<br/>confirmé ?"}
    AJ -->|Non| AK["Absence chauffeur<br/>(Driver No-Show)"]
    AJ -->|Oui| AL["Départ confirmé<br/>Status: COMPLETED"]

    AK --> AM["Remboursement complet<br/>au passager"]
    AM --> AN["Notification de<br/>remboursement"]

    AL --> AO["Fin du trajet"]
    AO --> AP["Passager note<br/>le chauffeur"]
    AP --> AQ["Chauffeur note<br/>le passager"]
    AQ --> AR["Trajet terminé<br/>avec succès"]

    AN --> AR
    AH --> AR

    AR --> AS["Libérer les fonds<br/>(Escrow)"]
    AS --> AT["Créditer le portefeuille<br/>du chauffeur"]
    AT --> AU["Transaction<br/>finalisée"]

    classDef startStyle fill:#A5D6A7,stroke:#2E7D32,color:#000,stroke-width:3px
    classDef processStyle fill:#BBDEFB,stroke:#1565C0,color:#000,stroke-width:2px
    classDef decisionStyle fill:#FFE0B2,stroke:#E65100,color:#000,stroke-width:3px
    classDef successStyle fill:#C8E6C9,stroke:#2E7D32,color:#000,stroke-width:2px
    classDef errorStyle fill:#FFCDD2,stroke:#C62828,color:#000,stroke-width:2px
    classDef endStyle fill:#E1BEE7,stroke:#6A1B9A,color:#000,stroke-width:3px

    class A startStyle
    class C,D,H,M,N,O,T,Y,Z,AA,AB,AC,AF,AI,AL,AO,AP,AQ,AR,AS,AT,AU processStyle
    class B,E,J,P,U,W,AD,AJ decisionStyle
    class K,V,X,AK,AE errorStyle
    class AU endStyle
