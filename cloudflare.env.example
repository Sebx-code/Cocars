# ============================================================================
# Cloudflare Tunnel URLs Configuration - Example
# ============================================================================
#
# This is the EXAMPLE file showing the structure of cloudflare.env
# DO NOT commit the actual cloudflare.env file with real URLs to version control!
# 
# To set up your configuration:
#   1. Copy this file: cp cloudflare.env.example cloudflare.env
#   2. Update with your actual Cloudflare Tunnel URLs
#   3. Run: node setup-cloudflare-urls.js <backend> <frontend> <reverb>
#
# ============================================================================

# Backend API URL
# Example: https://show-frequencies-nearest-wholesale.trycloudflare.com
CLOUDFLARE_BACKEND=https://your-backend-url.trycloudflare.com

# Frontend URL (for CORS)
# Example: https://provides-appears-fonts-curves.trycloudflare.com
CLOUDFLARE_FRONTEND=https://your-frontend-url.trycloudflare.com

# WebSocket (Reverb) URL
# Example: https://phases-bridal-bon-bargain.trycloudflare.com
CLOUDFLARE_REVERB=https://your-reverb-url.trycloudflare.com

# ============================================================================
# Extracted domains (auto-populated by setup script)
# ============================================================================
CLOUDFLARE_BACKEND_DOMAIN=your-backend-url.trycloudflare.com
CLOUDFLARE_FRONTEND_DOMAIN=your-frontend-url.trycloudflare.com
CLOUDFLARE_REVERB_DOMAIN=your-reverb-url.trycloudflare.com
